# Environment Configuration Template
# Copy this file to .env and fill in with your actual values

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=production

# ==========================================
# Server Configuration
# ==========================================
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ==========================================
# Database Configuration
# ==========================================
DB_HOST=your-database-host.com
DB_USER=procurement_user
DB_PASSWORD=your-secure-database-password
DB_NAME=procurement
DB_PORT=3306

# Constructed DATABASE_URL (used by Prisma)
# IMPORTANT: Write the full URL manually. Dotenv doesn't expand ${variables}
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: mysql://root:@localhost:3306/procurement (empty password)
# Example: mysql://user:pass123@localhost:3306/procurement (with password)
DATABASE_URL=mysql://procurement_user:your-secure-database-password@your-database-host.com:3306/procurement

# ==========================================
# Security Configuration
# ==========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
API_TOKEN_SECRET=x-api-token

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost

# ==========================================
# Frontend Configuration
# ==========================================
# API base URL for frontend
# Same domain with reverse proxy: /api
# Different domain: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:3000/api
VITE_TOKEN_SECRET=x-api-token

# ==========================================
# Docker Port Mapping (Optional)
# ==========================================
API_PORT=3000
WEB_PORT=80
