{
  "name": "@procurement/api",
  "version": "1.0.0",
  "description": "Procurement Vessel Management API",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --sourcemap",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "dev": "nodemon --exec \"node --import tsx\" src/server.ts",
    "dev:ts": "tsx watch src/server.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs backend-proc",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "keywords": [],
  "author": "Muhammad Rizq Ramadhan",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#modules/*": "./src/modules/*",
    "#config/*": "./src/config/*"
  },
  "dependencies": {
    "@procurement/types": "*",
    "@procurement/validators": "*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.3",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "pm2": "^5.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
