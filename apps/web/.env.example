# API Base URL
# The base URL for the backend API
# Development: http://localhost:3000/api
# Production: https://api.yourdomain.com/api or /api (if using reverse proxy)
VITE_API_BASE_URL=http://localhost:3000/api

# Token Secret
# The header name/key used for storing the API token in localStorage
# This should match the API_TOKEN_SECRET on the backend
VITE_TOKEN_SECRET=x-api-token
